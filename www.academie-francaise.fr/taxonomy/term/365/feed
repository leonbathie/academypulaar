&lt;/td&gt;
&lt;td style=&quot;width:209.05pt&quot; width=&quot;279&quot;&gt;
&lt;p align=&quot;center&quot; style=&quot;text-align:center&quot;&gt;&lt;strong&gt;on ne dit pas&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:203.6pt&quot; width=&quot;271&quot;&gt;
&lt;p&gt;&lt;i&gt;Une arcade orbitaire, un nerf orbitaire&lt;/i&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;i&gt;Le mouvement orbital d’un astre&lt;/i&gt;&lt;/p&gt;
&lt;/td&gt;
